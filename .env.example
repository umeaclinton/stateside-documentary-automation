# ====================================================================
# YouTube Shorts Automation - Environment Variables
# ====================================================================

# 1. Google Gemini AI API Key (Free tier at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. B-Roll Video API Keys (100% Free)
# Pixabay API: Instant free key at https://pixabay.com/api/docs/ (Recommended!)
PIXABAY_API_KEY=your_pixabay_api_key_here
# Pexels API: Free tier at https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# 3. Content Niche & Topic Selection
# Evergreen options: "Psychology & Human Behavior", "Stoicism & Ancient Wisdom",
#                    "Financial Literacy & Wealth Mindset", "Unsolved Mysteries & Deep Science"
CONTENT_NICHE=Psychology & Human Behavior

# 4. Neural Voice & Voice Cloning Settings
# Option A: Your Cloned Voice (ElevenLabs)
# Upload a 1-min audio of your voice to https://elevenlabs.io -> VoiceLab -> Instant Clone
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Option B: 100% Free Microsoft Edge-TTS Neural Voice (Default / Fallback)
# Popular high-retention options:
# - en-US-ChristopherNeural (Male, warm, narrative authority)
# - en-US-GuyNeural (Male, casual, relatable)
# - en-US-JennyNeural (Female, natural, crisp)
# - en-GB-RyanNeural (British male, documentary tone)
VOICE_NAME=en-US-ChristopherNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz

# 5. Video Composition Settings
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
FPS=30
MIN_CLIP_DURATION=3.5
MAX_CLIP_DURATION=5.0
MAX_VIDEO_DURATION_SECONDS=55

# 6. Captions & Style Settings
FONT_NAME=Impact
FONT_SIZE=70
FONT_COLOR=&H00FFFFFF
OUTLINE_COLOR=&H00000000
HIGHLIGHT_COLOR=&H0000FFFF

# 7. YouTube Data API v3 Configuration
# Path to your downloaded client_secret.json (from Google Cloud Console)
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=oauth_token.json

# Default privacy status for uploaded videos: "private", "unlisted", or "public"
YOUTUBE_PRIVACY_STATUS=public
